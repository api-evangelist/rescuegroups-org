{
  "opencollection": "1.0.0",
  "info": {
    "name": "RescueGroups.org Animals Breeds API",
    "version": "5.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Breeds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Animal Breeds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rescuegroups.org/v5/public/animals/breeds",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated results."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of records per page (max 250)."
              }
            ]
          },
          "docs": "Retrieve all animal breed reference values."
        }
      ]
    }
  ],
  "bundled": true
}